{
  "name": "forecast-v2",
  "version": "1.0.0",
  "description": "Data forecasting with Zod validation",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "node --test --require ts-node/register test/*.test.ts",
    "verify:worker": "node node_modules/wrangler-direct/bin/wrangler.js deploy --dry-run --outdir=dist-worker",
    "verify:relay": "npm --prefix relay/notam ci && npm --prefix relay/notam run build && npm --prefix relay/notam test",
    "verify:full": "npm run build && npm test && npm run verify:relay && npm run verify:worker",
    "postinstall": "node scripts/install-wrangler-gate.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wrangler": "file:tools/wrangler-github",
    "wrangler-direct": "npm:wrangler@4.114.0"
  },
  "types": "./dist/index.d.ts",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260722.1": true
  }
}
