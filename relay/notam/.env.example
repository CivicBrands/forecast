# SWIM JMS connection (from the FAA SWIM portal; rotate the password if exposed)
SWIM_URL=tcps://ems1.swim.faa.gov:55443
SWIM_VPN=AIM_FNS
SWIM_USERNAME=your.username
SWIM_PASSWORD=
SWIM_QUEUE=your.username.AIM_FNS.<uuid>.OUT

# Forecast Worker ingest endpoint and bearer token (must match `wrangler secret put INGEST_TOKEN`)
INGEST_URL=https://forecast.civicbrands.org/ingest/notam
INGEST_TOKEN=

# Geo filter — drop NOTAMs outside this radius before forwarding
USER_LAT=39.0997
USER_LON=-94.5786
RADIUS_MILES=30
# Set to 0 to forward every NOTAM (national firehose). Default 1.
GEO_FILTER=1

# Batching
BATCH_MAX_RECORDS=50
BATCH_MAX_AGE_MS=30000
